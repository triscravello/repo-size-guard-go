{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/bin/repo-size-guard",
            "args": ["hook"],
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}